package dashboard

import (
	"fmt"
	"time"

	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/toast"
)

type layoutConfig struct {
	autoRefresh time.Duration
}

type LayoutOption func(*layoutConfig)

// WithAutoRefresh configures the layout to emit a meta http-equiv refresh tag.
func WithAutoRefresh(d time.Duration) LayoutOption {
	return func(cfg *layoutConfig) {
		cfg.autoRefresh = d
	}
}

templ Layout(title string, activeTab string, isDefaultPassword bool, content templ.Component, opts ...LayoutOption) {
	{{
		var cfg layoutConfig
		for _, opt := range opts {
			opt(&cfg)
		}
	}}
	<!DOCTYPE html>
	<html lang="en" class="h-full dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			if cfg.autoRefresh > 0 {
				<meta http-equiv="refresh" content={ fmt.Sprintf("%d", int(cfg.autoRefresh.Seconds())) }/>
			}
			<title>{ title } - tinyroute Dashboard</title>
			<link rel="stylesheet" href="/dashboard/assets/styles.css"/>
			<!-- Component JS (dialog, popover, calendar, select, floating-ui,
			     inputgroup) loads as one content-hashed bundle via
			     @components.Scripts(); filter.js and dropdown.js are
			     dashboard-local and load separately. -->
			<script defer src="/dashboard/assets/filter.js"></script>
			<script defer src="/dashboard/assets/dropdown.js"></script>
			@components.Scripts()
		</head>
		<body class="h-full text-foreground bg-background font-sans flex flex-col md:flex-row antialiased">
			<!-- Mobile Navigation Header -->
			<div class="md:hidden flex items-center justify-between bg-card border-b border-border p-4">
				<div class="flex items-center space-x-2">
					<div class="p-1.5 bg-primary/10 text-primary rounded-lg border border-primary/20">
						@icon.Route(icon.Props{Class: "size-5"})
					</div>
					<span class="font-semibold tracking-tight text-foreground">tinyroute</span>
				</div>
				<a href="/dashboard/logout" class="text-xs text-muted-foreground hover:text-foreground flex items-center gap-1">
					@icon.LogOut(icon.Props{Class: "size-4"})
					Logout
				</a>
			</div>

			<!-- Sidebar -->
			<aside class="w-full md:w-64 bg-card border-r border-border flex flex-col justify-between shrink-0">
				<div>
					<div class="hidden md:flex items-center space-x-3 p-6 border-b border-border">
						<div class="p-2 bg-primary/10 text-primary rounded-xl border border-primary/20 shadow-xs">
							@icon.Route(icon.Props{Class: "size-6"})
						</div>
						<div>
							<h1 class="font-bold text-base tracking-tight text-foreground">tinyroute</h1>
							<p class="text-xs text-muted-foreground font-mono">gateway dashboard</p>
						</div>
					</div>

					<nav class="p-4 space-y-1">
						@navItem("Overview", "/dashboard/overview", icon.LayoutDashboard, activeTab == "overview")
						@navItem("Providers", "/dashboard/providers", icon.Cpu, activeTab == "providers")
						@navItem("Combos", "/dashboard/combos", icon.Layers, activeTab == "combos")
						@navItem("History", "/dashboard/history", icon.History, activeTab == "history")
						@navItem("API Keys", "/dashboard/keys", icon.Key, activeTab == "keys")
						@navItem("Clients", "/dashboard/clients", icon.Terminal, activeTab == "clients")
						@navItem("Settings", "/dashboard/settings", icon.Settings, activeTab == "settings")
					</nav>
				</div>

				<div class="p-4 border-t border-border space-y-3">
					if isDefaultPassword {
						<div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-lg text-xs text-amber-300 flex items-start gap-2.5 shadow-xs">
							<div class="shrink-0 mt-0.5 text-amber-400">
								@icon.TriangleAlert(icon.Props{Class: "size-4"})
							</div>
							<div>
								<p class="font-medium text-amber-200">Default Password Active</p>
								<p class="text-amber-400/80 text-[11px] mt-0.5">Change default password in <a href="/dashboard/settings" class="underline hover:text-white font-medium">Settings</a>.</p>
							</div>
						</div>
					}
					<div class="flex items-center justify-between pt-2">
						<span class="text-xs text-muted-foreground font-mono">127.0.0.1:8787</span>
						<a href="/dashboard/logout" class="text-xs font-medium text-muted-foreground hover:text-destructive flex items-center gap-1 transition-colors">
							@icon.LogOut(icon.Props{Class: "size-3.5"})
							Logout
						</a>
					</div>
				</div>
			</aside>

			<!-- Main View Area -->
			<main class="flex-1 overflow-y-auto p-6 lg:p-10 bg-background">
				<div class="max-w-7xl mx-auto">
					@content
				</div>
			</main>

			<!-- Global Viewport Toast Notification Center -->
			@toast.Toaster()
		</body>
	</html>
}

templ navItem(label string, href string, iconFn components.IconFunc, isActive bool) {
	if isActive {
		<a href={ templ.SafeURL(href) } class="flex items-center space-x-3 px-3.5 py-2.5 rounded-lg bg-accent text-accent-foreground font-medium text-sm border border-border transition-all shadow-xs">
			@iconFn(icon.Props{Class: "size-4 text-primary"})
			<span>{ label }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent/50 font-medium text-sm transition-all">
			@iconFn(icon.Props{Class: "size-4 text-muted-foreground"})
			<span>{ label }</span>
		</a>
	}
}
