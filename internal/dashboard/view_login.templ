package dashboard

import (
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/input"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/label"
)

templ Login(errorMsg string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Login - tinyroute Dashboard</title>
			<link rel="stylesheet" href="/dashboard/assets/styles.css"/>
			@input.Script()
		</head>
		<body class="h-full flex items-center justify-center p-4 bg-background text-foreground antialiased">
			<div class="w-full max-w-md">
				@card.Card(card.Props{Class: "shadow-xl border-border bg-card"}) {
					@card.Header(card.HeaderProps{Class: "text-center space-y-2 pb-4"}) {
						<div class="mx-auto inline-flex p-3 bg-primary/10 text-primary rounded-2xl border border-primary/20 mb-2">
							@icon.Route(icon.Props{Class: "w-8 h-8"})
						</div>
						@card.Title(card.TitleProps{Class: "text-2xl font-bold tracking-tight text-foreground"}) {
							tinyroute dashboard
						}
						@card.Description(card.DescriptionProps{Class: "text-xs text-muted-foreground"}) {
							Enter your management password to continue
						}
					}
					@card.Content(card.ContentProps{Class: "space-y-4 pt-0"}) {
						if errorMsg != "" {
							@components.AlertBanner(components.AlertBannerProps{
								Variant:     components.AlertError,
								Title:       "Authentication Failed",
								Description: errorMsg,
							})
						}

						<form method="POST" action="/dashboard/login" class="space-y-4">
							<div class="space-y-2">
								@label.Label(label.Props{For: "password", Class: "text-xs font-medium text-foreground"}) {
									Password
								}
								@input.Input(input.Props{
									ID:          "password",
									Name:        "password",
									Type:        input.TypePassword,
									Placeholder: "••••••••",
									Required:    true,
									Attributes:  templ.Attributes{"autofocus": "autofocus"},
								})
							</div>

							@button.Button(button.Props{
								Type:      button.TypeSubmit,
								FullWidth: true,
								Class:     "shadow-sm",
							}) {
								<span>Sign In</span>
								@icon.ArrowRight(icon.Props{Class: "size-4"})
							}
						</form>
					}
					@card.Footer(card.FooterProps{Class: "justify-center border-t border-border pt-4 pb-4"}) {
						<p class="text-xs text-muted-foreground">Default password is <code class="px-1.5 py-0.5 bg-muted rounded border border-border text-foreground font-mono">123456</code></p>
					}
				}
			</div>
		</body>
	</html>
}
