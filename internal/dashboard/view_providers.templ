package dashboard

import (
	"fmt"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/assets"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/dialog"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/empty"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/input"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/inputgroup"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/label"
	selectcomp "github.com/oniharnantyo/tinyroute/internal/dashboard/components/select"
)

type MaskedConnectionItem struct {
	Account            string
	Provider           string
	RefreshToken       string
	ExpiresAt          string
	Type               string // "oauth" or "static"
	AffectedComboCount int
}

type ProviderCardModel struct {
	TinyRouteName string
	ProviderModel string
}

type ProviderCardData struct {
	Name             string
	DisplayName      string
	Logo             string
	Dialect          string
	BaseURL          string
	HasAPIKey        bool
	HasCredential    bool
	HealthStatus     string // "healthy", "cooldown"
	ConnectionCount  int
	WhitelistedCount int
	Configured       bool
	AuthType         string // "oauth", "api key", "—"
	Tier             string // "free", "freemium"
	FreeNote         string
	Section          string // "Free Tier", "OAuth", "API Key"
}

type ProviderSection struct {
	Title string
	Cards []ProviderCardData
}

type ProvidersPageData struct {
	Sections []ProviderSection
}

templ ProvidersPage(data ProvidersPageData) {
	<div class="space-y-6">
		<!-- Flash/error feedback renders as a toast via the layout Toaster's
		     checkUrlFlash(); no static banner here. -->

		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold tracking-tight text-foreground">Providers</h2>
				<p class="text-xs text-muted-foreground">Browse and manage upstream AI providers and API credentials</p>
			</div>

			<!-- Add Custom Provider Modal Trigger & Dialog -->
			@dialog.Dialog(dialog.Props{ID: "dialog-add-custom-provider"}) {
				@dialog.Trigger(dialog.TriggerProps{For: "dialog-add-custom-provider"}) {
					@button.Button(button.Props{
						Class: "shadow-sm gap-2",
					}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						<span>Add Custom Provider</span>
					}
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Add Custom Provider
						}
						@dialog.Description() {
							Configure a custom OpenAI, Anthropic, or Gemini compatible endpoint.
						}
					}
					<form method="POST" action="/dashboard/providers/add-custom" class="space-y-4 mt-2">
						<div class="space-y-2">
							@label.Label(label.Props{For: "provider-name", Class: "text-xs font-medium text-foreground"}) {
								Provider Name
							}
							@input.Input(input.Props{
								ID:          "provider-name",
								Name:        "name",
								Placeholder: "e.g. my-custom-llm",
								Required:    true,
								Class:       "font-mono",
							})
						</div>

						<div class="space-y-2">
							@label.Label(label.Props{For: "provider-dialect", Class: "text-xs font-medium text-foreground"}) {
								Dialect
							}
							@selectcomp.Select(selectcomp.Props{
								Name:         "dialect",
								DefaultValue: "openai",
							}) {
								@selectcomp.Trigger(selectcomp.TriggerProps{
									ID:    "provider-dialect",
									Class: "w-full h-9 rounded-md text-sm",
								}) {
									@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select dialect"})
								}
								@selectcomp.Content() {
									@selectcomp.Item(selectcomp.ItemProps{Value: "openai"}) { openai }
									@selectcomp.Item(selectcomp.ItemProps{Value: "anthropic"}) { anthropic }
									@selectcomp.Item(selectcomp.ItemProps{Value: "gemini"}) { gemini }
								}
							}
						</div>

						<div class="space-y-2">
							@label.Label(label.Props{For: "provider-base-url", Class: "text-xs font-medium text-foreground"}) {
								Base URL
							}
							@input.Input(input.Props{
								ID:          "provider-base-url",
								Name:        "base_url",
								Type:        input.TypeURL,
								Placeholder: "https://api.myllm.com/v1",
								Required:    true,
								Class:       "font-mono",
							})
						</div>

						@dialog.Footer(dialog.FooterProps{Class: "pt-4 border-t border-border mt-4"}) {
							@dialog.Close() {
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Type:    button.TypeButton,
								}) {
									Cancel
								}
							}
							@button.Button(button.Props{
								Type: button.TypeSubmit,
							}) {
								Add Custom Provider
							}
						}
					</form>
				}
			}
		</div>

		<!-- Provider Filter Search -->
		@inputgroup.InputGroup() {
			@inputgroup.Addon() {
				@icon.Search()
			}
			@inputgroup.Input(inputgroup.InputProps{
				Type:        "search",
				Placeholder: "Search providers by name or dialect...",
				Attributes:  templ.Attributes{"data-filter-input": "providers"},
			})
		}

		<!-- Grouped Provider Cards Sections -->
		if len(data.Sections) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Cpu()
					}
					@empty.Title() { No Providers Found }
					@empty.Description() { Get started by adding a custom provider or configuring a preset. }
				}
			}
		} else {
			for _, sec := range data.Sections {
				<div class="space-y-3">
					<div class="flex items-center justify-between border-b border-border pb-2">
						<h3 class="font-bold text-xs text-foreground tracking-wider uppercase flex items-center gap-2">
							<span class="size-2 rounded-full bg-primary"></span>
							{ sec.Title } ({ fmt.Sprintf("%d", len(sec.Cards)) })
						</h3>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, prov := range sec.Cards {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/dashboard/providers/%s", prov.Name)) }
								data-filter-item="providers"
								data-filter-text={ fmt.Sprintf("%s %s %s", prov.Name, prov.DisplayName, prov.Dialect) }
								class="block group"
							>
								@card.Card(card.Props{
									Class: "h-full p-5 flex flex-col justify-between transition-all hover:border-primary/50 hover:bg-muted/30 group-hover:shadow-md",
								}) {
									<div class="space-y-3">
										<div class="flex items-center space-x-3">
											@providerLogo(prov.Name, prov.Logo)
											<div>
												<h3 class="font-semibold text-sm text-foreground tracking-tight group-hover:text-primary transition-colors">
													if prov.DisplayName != "" {
														{ prov.DisplayName }
													} else {
														{ prov.Name }
													}
												</h3>
												if prov.Tier != "" {
													<div class="flex items-center gap-1.5 mt-0.5">
														@components.StatusBadge(components.StatusBadgeProps{
															Variant: components.StatusWarning,
															Class:   "text-[10px] px-1.5 py-0 font-mono",
														}) {
															{ prov.Tier }
														}
													</div>
												}
											</div>
										</div>

										if prov.FreeNote != "" {
											<p class="text-[11px] text-amber-400/90 italic">{ prov.FreeNote }</p>
										}
									</div>

									<div class="pt-3 border-t border-border flex items-center justify-between mt-3">
										if prov.Configured {
											<div class="flex items-center space-x-1.5 text-[11px] font-mono text-muted-foreground">
												<span class="px-1.5 py-0.5 rounded bg-muted border border-border text-foreground">
													{ fmt.Sprintf("%d conn", prov.ConnectionCount) }
												</span>
												<span class="px-1.5 py-0.5 rounded bg-muted border border-border text-foreground">
													{ fmt.Sprintf("%d models", prov.WhitelistedCount) }
												</span>
											</div>
											<span class="text-xs text-primary group-hover:translate-x-0.5 transition-transform">
												@icon.ChevronRight(icon.Props{Class: "size-4"})
											</span>
										} else {
											<span class="text-[11px] text-muted-foreground font-mono italic">Not configured</span>
											<span class="text-xs text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 transition-all">
												@icon.ChevronRight(icon.Props{Class: "size-4"})
											</span>
										}
									</div>
								}
							</a>
						}
					</div>
				</div>
			}
		}
	</div>
}

templ providerLogo(name string, logoName string) {
	if logoData, ok := assets.LogoSVG(logoName); ok && logoName != "" {
		<div class="size-7 flex items-center justify-center text-foreground shrink-0">
			@templ.Raw(string(logoData))
		</div>
	} else if logoData, ok := assets.LogoSVG(name); ok {
		<div class="size-7 flex items-center justify-center text-foreground shrink-0">
			@templ.Raw(string(logoData))
		</div>
	} else {
		<div class="size-7 bg-muted border border-border rounded-lg text-primary font-bold text-xs flex items-center justify-center uppercase font-mono shrink-0">
			{ name[:2] }
		</div>
	}
}
