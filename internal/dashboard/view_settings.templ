package dashboard

import "github.com/oniharnantyo/tinyroute/internal/dashboard/components"

type SettingsPageData struct {
	Flash string
	Error string
}

templ SettingsPage(data SettingsPageData) {
	<div class="space-y-6 max-w-xl">
		<div>
			<h2 class="text-xl font-bold tracking-tight text-white">Dashboard Settings</h2>
			<p class="text-xs text-slate-400">Manage security options and change administrator password</p>
		</div>


		<!-- Change Password Form -->
		<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
			<div class="border-b border-slate-800 pb-3">
				<h3 class="font-bold text-sm text-white flex items-center gap-2">
					@components.Icon("lock", "w-4 h-4 text-indigo-400")
					Change Dashboard Password
				</h3>
				<p class="text-xs text-slate-400 mt-0.5">Persisted atomically to <code class="px-1 py-0.5 bg-slate-950 rounded border border-slate-800 text-slate-300 font-mono text-[11px]">~/.tinyroute/dashboard.json</code></p>
			</div>

			<form method="POST" action="/dashboard/settings/password" class="space-y-4">
				<div class="space-y-1.5">
					<label for="current_password" class="block text-xs font-medium text-slate-300">Current Password</label>
					<input type="password" id="current_password" name="current_password" required class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500"/>
				</div>

				<div class="space-y-1.5">
					<label for="new_password" class="block text-xs font-medium text-slate-300">New Password</label>
					<input type="password" id="new_password" name="new_password" required minlength="6" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500"/>
				</div>

				<div class="space-y-1.5">
					<label for="confirm_password" class="block text-xs font-medium text-slate-300">Confirm New Password</label>
					<input type="password" id="confirm_password" name="confirm_password" required minlength="6" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500"/>
				</div>

				<div class="pt-2">
					<button type="submit" class="py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2">
						@components.Icon("check", "w-4 h-4")
						<span>Update Password</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
