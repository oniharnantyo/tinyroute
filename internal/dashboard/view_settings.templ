package dashboard

import (
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/input"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/label"
)

type SettingsPageData struct {
}

templ SettingsPage(data SettingsPageData) {
	<div class="space-y-6 max-w-xl">
		<div>
			<h2 class="text-xl font-bold tracking-tight text-foreground">Dashboard Settings</h2>
			<p class="text-xs text-muted-foreground">Manage security options and change administrator password</p>
		</div>

		<!-- Change Password Form -->
		@card.Card() {
			@card.Header(card.HeaderProps{Class: "border-b border-border pb-4"}) {
				@card.Title(card.TitleProps{Class: "text-sm font-semibold flex items-center gap-2 text-foreground"}) {
					@icon.Lock(icon.Props{Class: "size-4 text-primary"})
					Change Dashboard Password
				}
				@card.Description(card.DescriptionProps{Class: "text-xs text-muted-foreground mt-1"}) {
					Persisted atomically to <code class="px-1.5 py-0.5 bg-muted rounded border border-border text-foreground font-mono text-[11px]">~/.tinyroute/dashboard.json</code>
				}
			}

			@card.Content(card.ContentProps{Class: "p-6"}) {
				<form method="POST" action="/dashboard/settings/password" class="space-y-4">
					<div class="space-y-2">
						@label.Label(label.Props{For: "current_password", Class: "text-xs font-medium text-foreground"}) {
							Current Password
						}
						@input.Input(input.Props{
							ID:          "current_password",
							Name:        "current_password",
							Type:        input.TypePassword,
							Placeholder: "••••••••",
							Required:    true,
						})
					</div>

					<div class="space-y-2">
						@label.Label(label.Props{For: "new_password", Class: "text-xs font-medium text-foreground"}) {
							New Password
						}
						@input.Input(input.Props{
							ID:          "new_password",
							Name:        "new_password",
							Type:        input.TypePassword,
							Placeholder: "••••••••",
							Required:    true,
							Attributes:  templ.Attributes{"minlength": "6"},
						})
					</div>

					<div class="space-y-2">
						@label.Label(label.Props{For: "confirm_password", Class: "text-xs font-medium text-foreground"}) {
							Confirm New Password
						}
						@input.Input(input.Props{
							ID:          "confirm_password",
							Name:        "confirm_password",
							Type:        input.TypePassword,
							Placeholder: "••••••••",
							Required:    true,
							Attributes:  templ.Attributes{"minlength": "6"},
						})
					</div>

					<div class="pt-2">
						@button.Button(button.Props{
							Type:  button.TypeSubmit,
							Class: "shadow-sm",
						}) {
							@icon.Check(icon.Props{Class: "size-4"})
							<span>Update Password</span>
						}
					</div>
				</form>
			}
		}
	</div>
}
