package dashboard

import (
	"fmt"
	"net/url"
	"strings"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/badge"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/breadcrumb"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/dialog"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/dropdown"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/input"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/inputgroup"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/label"
)

type CatalogModelItem struct {
	ID          string
	Name        string
	Whitelisted bool
}

type ProviderDetailPageData struct {
	Name              string
	DisplayName       string
	Logo              string
	Dialect           string
	BaseURL           string
	APIKey            string
	Configured        bool
	OAuthCapable      bool
	HealthStatus      string // "healthy", "cooldown"
	Status            string // "connected", "cooldown", "awaiting_credentials", "not_connected"
	Connections       []MaskedConnectionItem
	Models            []CatalogModelItem
	WhitelistedModels []CatalogModelItem
	AvailableModels   []CatalogModelItem
	DeviceCode        string
	UserCode          string
	VerificationURI   string
	DeviceID          string
	Account           string
}

func sanitizeAccountID(acc string) string {
	r := strings.ReplaceAll(strings.ReplaceAll(acc, "@", "-at-"), ".", "-")
	return strings.ReplaceAll(r, "_", "-")
}

templ ProviderDetailPage(data ProviderDetailPageData) {
	<div class="space-y-6">
		<!-- Flash/error feedback renders as a toast via the layout Toaster's
		     checkUrlFlash(); no static banner here. -->

		<!-- Header Breadcrumb & Actions -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-4">
			<div class="space-y-2">
				@breadcrumb.Breadcrumb() {
					@breadcrumb.List() {
						@breadcrumb.Item() {
							@breadcrumb.Link(breadcrumb.LinkProps{Href: "/dashboard/providers"}) {
								Providers
							}
						}
						@breadcrumb.Separator()
						@breadcrumb.Item() {
							@breadcrumb.Page() {
								if data.DisplayName != "" {
									{ data.DisplayName }
								} else {
									{ data.Name }
								}
							}
						}
					}
				}
				<div class="flex items-center space-x-3">
					@providerLogo(data.Name, data.Logo)
					<h2 class="text-xl font-bold tracking-tight text-foreground">
						if data.DisplayName != "" {
							{ data.DisplayName }
						} else {
							{ data.Name }
						}
					</h2>
				</div>
			</div>
		</div>

		<!-- DEVICE CODE POLLING MODAL BANNER -->
		if data.DeviceCode != "" {
			<div
				id="device-auth-banner"
				data-device-code={ data.DeviceCode }
				data-device-id={ data.DeviceID }
				data-provider={ data.Name }
				data-account={ data.Account }
				class="bg-card border border-primary/40 rounded-xl p-6 shadow-xl space-y-4"
			>
				<div class="flex items-center justify-between border-b border-border pb-3">
					<h3 class="font-bold text-sm text-foreground uppercase tracking-wider flex items-center gap-2">
						@icon.Key(icon.Props{Class: "size-4 text-primary"})
						Device Authorization Required
					</h3>
					<span id="device-auth-status" class="text-xs text-primary font-mono">polling...</span>
				</div>
				<div class="space-y-3 text-xs">
					<p class="text-muted-foreground">Open the verification URL below and enter your user code to authorize:</p>
					<div class="p-3.5 bg-muted/50 border border-border rounded-lg space-y-2 font-mono">
						<div class="flex items-center justify-between">
							<span class="text-muted-foreground">User Code:</span>
							<span class="font-bold text-primary text-sm">{ data.UserCode }</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-muted-foreground">Verification URL:</span>
							<a href={ templ.SafeURL(data.VerificationURI) } target="_blank" class="text-primary hover:underline truncate max-w-xs">{ data.VerificationURI }</a>
						</div>
					</div>
					<div class="flex items-center gap-3 pt-2">
						@button.Button(button.Props{
							Href:   data.VerificationURI,
							Target: "_blank",
							Class:  "gap-1.5 shadow-sm",
						}) {
							<span>Open Authorization Page</span>
							@icon.ExternalLink(icon.Props{Class: "size-3.5"})
						}
						<a
							id="device-auth-restart"
							href={ templ.SafeURL(fmt.Sprintf("/dashboard/providers/%s/oauth/start", data.Name)) }
							class="hidden inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-md text-xs font-medium bg-amber-600 hover:bg-amber-500 text-white shadow-sm transition-colors"
						>
							@icon.RefreshCw(icon.Props{Class: "size-3.5"})
							<span>Restart Authorization</span>
						</a>
					</div>
				</div>
			</div>
		}

		<!-- CONNECTIONS SECTION -->
		@card.Card() {
			@card.Header(card.HeaderProps{Class: "border-b border-border pb-3 flex flex-row items-center justify-between space-y-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm font-semibold uppercase tracking-wider flex items-center gap-2 text-foreground"}) {
					@icon.Lock(icon.Props{Class: "size-4 text-primary"})
					Connections & Credentials
				}
				<div class="flex items-center gap-2">
					<span class="text-xs text-muted-foreground font-mono mr-2">{ fmt.Sprintf("%d active connections", len(data.Connections)) }</span>
					if data.OAuthCapable {
						@dialog.Trigger(dialog.TriggerProps{For: "dialog-connect-oauth"}) {
							@button.Button(button.Props{
								Size:  button.SizeSm,
								Class: "gap-1.5 shadow-sm cursor-pointer",
							}) {
								@icon.Key(icon.Props{Class: "size-3.5"})
								<span>Connect OAuth</span>
							}
						}
					}
					@dialog.Trigger(dialog.TriggerProps{For: "dialog-add-api-key"}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "gap-1.5 cursor-pointer",
						}) {
							@icon.Plus(icon.Props{Class: "size-3.5"})
							<span>Add Key</span>
						}
					}
				</div>
			}
			@card.Content(card.ContentProps{Class: "p-6 space-y-4"}) {
				if len(data.Connections) > 0 {
					<div class="space-y-2">
						for _, conn := range data.Connections {
							<div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 bg-muted/40 border border-border rounded-lg text-xs font-mono gap-2">
								<div class="space-y-1">
									<div class="flex items-center gap-2">
										<span class="font-bold text-foreground">{ conn.Account }</span>
										if conn.Type == "oauth" {
											@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] px-1.5 py-0"}) {
												OAuth
											}
										} else {
											@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] px-1.5 py-0"}) {
												Static Key
											}
										}
									</div>
									<div class="text-muted-foreground text-[11px]">Digest: { conn.RefreshToken }</div>
								</div>
								<div class="flex items-center gap-3">
									if conn.Type == "oauth" {
										<span class="text-muted-foreground text-[11px]">Expires: { conn.ExpiresAt }</span>
									}
									@dropdown.Dropdown() {
										@dropdown.Trigger() {
											@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "h-7 w-7 p-0 text-muted-foreground hover:text-foreground cursor-pointer"}) {
												@icon.Ellipsis(icon.Props{Class: "size-4"})
											}
										}
										@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-40 text-xs"}) {
											if conn.Type == "oauth" {
												@dropdown.Item(dropdown.ItemProps{Href: fmt.Sprintf("/dashboard/providers/%s/oauth/start?account=%s", data.Name, url.QueryEscape(conn.Account)), Class: "gap-2"}) {
													@icon.RefreshCw(icon.Props{Class: "size-3.5 text-muted-foreground"})
													<span>Reconnect</span>
												}
											}
											@dialog.Trigger(dialog.TriggerProps{For: "dialog-rename-" + sanitizeAccountID(conn.Account)}) {
												@dropdown.Item(dropdown.ItemProps{Class: "gap-2 cursor-pointer"}) {
													@icon.Pencil(icon.Props{Class: "size-3.5 text-muted-foreground"})
													<span>Rename</span>
												}
											}
											@dropdown.Separator()
											@dialog.Trigger(dialog.TriggerProps{For: "dialog-disconnect-" + sanitizeAccountID(conn.Account)}) {
												@dropdown.Item(dropdown.ItemProps{Class: "gap-2 cursor-pointer text-destructive hover:bg-destructive/10"}) {
													@icon.Trash2(icon.Props{Class: "size-3.5"})
													<span>Disconnect</span>
												}
											}
										}
									}
								</div>
							</div>
						}
					</div>
				} else {
					<p class="text-xs text-muted-foreground italic">No OAuth or stored credential records configured for this provider.</p>
				}

				if data.APIKey != "" && len(data.Connections) == 0 {
					<div class="p-3.5 bg-muted/40 border border-border rounded-lg text-xs font-mono flex items-center justify-between">
						<div class="space-y-0.5">
							<span class="text-foreground font-medium">Legacy Static API Key</span>
							<div class="text-emerald-400 text-[11px]">Configured (scalar fallback)</div>
						</div>
						<form method="POST" action="/dashboard/providers/credential/delete" onsubmit="return confirm('Are you sure you want to remove the API key?');">
							<input type="hidden" name="name" value={ data.Name }/>
							<input type="hidden" name="type" value="api_key"/>
							@button.Button(button.Props{
								Type:    button.TypeSubmit,
								Variant: button.VariantDestructive,
								Size:    button.SizeSm,
								Class:   "gap-1.5",
							}) {
								@icon.Trash(icon.Props{Class: "size-3.5"})
								<span>Remove API Key</span>
							}
						</form>
					</div>
				}
			}
		}

		<!-- DIALOGS -->
		<!-- Connect OAuth Dialog -->
		if data.OAuthCapable {
			@dialog.Dialog(dialog.Props{ID: "dialog-connect-oauth"}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
					@dialog.Header() {
						@dialog.Title() {
							Connect OAuth Account
						}
						@dialog.Description() {
							Authenticate with { data.DisplayName } in browser. You can provide an optional account label.
						}
					}
					<form method="GET" action={ templ.SafeURL(fmt.Sprintf("/dashboard/providers/%s/oauth/start", data.Name)) } class="space-y-4 pt-2">
						<div class="space-y-1.5">
							@label.Label(label.Props{For: "connect-oauth-account"}) {
								Account Label (Optional)
							}
							@input.Input(input.Props{
								ID:          "connect-oauth-account",
								Name:        "account",
								Placeholder: "e.g. work, personal, team2",
							})
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "pt-4 border-t border-border mt-4 flex justify-end gap-2"}) {
							@dialog.Close(dialog.CloseProps{For: "dialog-connect-oauth"}) {
								@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
									Cancel
								}
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Class: "gap-1.5"}) {
								@icon.Key(icon.Props{Class: "size-4"})
								<span>Authorize in Browser</span>
							}
						}
					</form>
				}
			}
		}

		<!-- Add API Key Dialog -->
		@dialog.Dialog(dialog.Props{ID: "dialog-add-api-key"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						Add API Key Account
					}
					@dialog.Description() {
						Add a static API key or secret token for { data.DisplayName }.
					}
				}
				<form method="POST" action="/dashboard/providers/credential" class="space-y-4 pt-2">
					<input type="hidden" name="name" value={ data.Name }/>
					<div class="space-y-1.5">
						@label.Label(label.Props{For: "add-key-secret"}) {
							API Key / Secret Token
						}
						@input.Input(input.Props{
							ID:          "add-key-secret",
							Name:        "api_key",
							Type:        "password",
							Placeholder: "sk-...",
							Required:    true,
							Class:       "font-mono",
						})
					</div>
					<div class="space-y-1.5">
						@label.Label(label.Props{For: "add-key-account"}) {
							Account Label (Optional)
						}
						@input.Input(input.Props{
							ID:          "add-key-account",
							Name:        "account",
							Placeholder: "e.g. default, backup, prod",
						})
					</div>
					@dialog.Footer(dialog.FooterProps{Class: "pt-4 border-t border-border mt-4 flex justify-end gap-2"}) {
						@dialog.Close(dialog.CloseProps{For: "dialog-add-api-key"}) {
							@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
								Cancel
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "gap-1.5"}) {
							@icon.Plus(icon.Props{Class: "size-4"})
							<span>Save Account Key</span>
						}
					}
				</form>
			}
		}

		<!-- Rename Dialogs for each connection -->
		for _, conn := range data.Connections {
			@dialog.Dialog(dialog.Props{ID: "dialog-rename-" + sanitizeAccountID(conn.Account)}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
					@dialog.Header() {
						@dialog.Title() {
							Rename Account
						}
						@dialog.Description() {
							Change the identifier for this connection from <span class="font-mono font-semibold">{ conn.Account }</span>.
						}
					}
					<form method="POST" action="/dashboard/providers/account/rename" class="space-y-4 pt-2">
						<input type="hidden" name="provider" value={ data.Name }/>
						<input type="hidden" name="old_account" value={ conn.Account }/>
						<div class="space-y-1.5">
							@label.Label(label.Props{For: "rename-input-" + sanitizeAccountID(conn.Account)}) {
								New Account Name
							}
							@input.Input(input.Props{
								ID:          "rename-input-" + sanitizeAccountID(conn.Account),
								Name:        "new_account",
								Value:       conn.Account,
								Placeholder: "e.g. pool-1, backup, prod",
								Required:    true,
							})
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "pt-4 border-t border-border mt-4 flex justify-end gap-2"}) {
							@dialog.Close(dialog.CloseProps{For: "dialog-rename-" + sanitizeAccountID(conn.Account)}) {
								@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
									Cancel
								}
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Class: "gap-1.5"}) {
								@icon.Check(icon.Props{Class: "size-4"})
								<span>Save New Name</span>
							}
						}
					</form>
				}
			}
		}

		<!-- Disconnect Confirmation Dialogs for each connection -->
		for _, conn := range data.Connections {
			@dialog.Dialog(dialog.Props{ID: "dialog-disconnect-" + sanitizeAccountID(conn.Account)}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
					@dialog.Header() {
						@dialog.Title() {
							Disconnect Connection
						}
						@dialog.Description() {
							Are you sure you want to disconnect account <strong class="text-foreground font-mono">{ conn.Account }</strong> from { data.DisplayName }?
						}
					}
					if conn.AffectedComboCount > 0 {
						<div class="text-xs text-muted-foreground p-3 rounded-md bg-destructive/10 border border-destructive/20 space-y-1 mt-2 text-left">
							<p class="font-medium text-destructive">Warning: Combo routing will be affected.</p>
							<p>{ fmt.Sprintf("%d combo(s) referencing this connection will be adjusted.", conn.AffectedComboCount) }</p>
						</div>
					}
					<form method="POST" action="/dashboard/providers/credential/delete" class="mt-4">
						<input type="hidden" name="name" value={ data.Name }/>
						<input type="hidden" name="account" value={ conn.Account }/>
						<input type="hidden" name="type" value={ conn.Type }/>
						@dialog.Footer(dialog.FooterProps{Class: "pt-4 border-t border-border mt-4 flex justify-end gap-2"}) {
							@dialog.Close(dialog.CloseProps{For: "dialog-disconnect-" + sanitizeAccountID(conn.Account)}) {
								@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
									Cancel
								}
							}
							@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit}) {
								Disconnect
							}
						}
					</form>
				}
			}
		}

		<!-- MODELS SECTION -->
		@card.Card() {
			@card.Header(card.HeaderProps{Class: "border-b border-border pb-3 flex flex-row items-center justify-between space-y-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm font-semibold uppercase tracking-wider flex items-center gap-2 text-foreground"}) {
					@icon.Cpu(icon.Props{Class: "size-4 text-primary"})
					Models ({ fmt.Sprintf("%d", len(data.Models)) })
				}
			}

			@card.Content(card.ContentProps{Class: "p-6 space-y-6"}) {
				if len(data.Models) == 0 {
					<p class="text-xs text-muted-foreground italic">No catalog models found. Enter a custom model name below to whitelist it.</p>
				} else {
					<div class="space-y-6">
						<div class="flex items-center">
							<div class="w-full sm:w-72">
								@inputgroup.InputGroup() {
									@inputgroup.Addon() {
										@icon.Search()
									}
									@inputgroup.Input(inputgroup.InputProps{
										Type:        "search",
										Placeholder: "Filter models...",
										Attributes:  templ.Attributes{"data-filter-input": "models"},
									})
								}
							</div>
						</div>

						if len(data.WhitelistedModels) > 0 {
							<div class="space-y-3">
								<div class="flex items-center gap-2">
									<span class="size-2 rounded-full bg-primary"></span>
									<h4 class="text-xs font-semibold text-foreground uppercase tracking-wider">Whitelisted ({ fmt.Sprintf("%d", len(data.WhitelistedModels)) })</h4>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
									for _, m := range data.WhitelistedModels {
										@modelCard(data.Name, m)
									}
								</div>
							</div>
						}

						if len(data.AvailableModels) > 0 {
							<div class="space-y-3">
								<div class="flex items-center gap-2">
									<span class="size-2 rounded-full bg-muted-foreground"></span>
									<h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Available in Catalog ({ fmt.Sprintf("%d", len(data.AvailableModels)) })</h4>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
									for _, m := range data.AvailableModels {
										@modelCard(data.Name, m)
									}
								</div>
							</div>
						}
					</div>
				}

				<!-- Custom Model Input Escape Hatch -->
				<form method="POST" action="/dashboard/models/add" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-4 border-t border-border">
					<input type="hidden" name="provider" value={ data.Name }/>
					<input type="text" id="custom_model_input" name="model" placeholder="Custom model name (e.g. gpt-4o)" required class="flex-1 px-3.5 py-2 bg-transparent border border-input rounded-md text-xs text-foreground placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none font-mono"/>
					@button.Button(button.Props{
						Type:  button.TypeSubmit,
						Class: "shrink-0 gap-1.5",
					}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						<span>Add Model</span>
					}
				</form>
			}
		}

		@providerDetailScripts()
	</div>
}

templ modelCard(provider string, m CatalogModelItem) {
	<div
		data-filter-item="models"
		data-filter-text={ fmt.Sprintf("%s %s", m.ID, m.Name) }
		class="p-3.5 bg-card border border-border rounded-lg space-y-2.5 flex flex-col justify-between"
	>
		<div>
			<div class="flex items-center justify-between gap-2">
				<span class="font-bold text-xs text-foreground font-mono tracking-tight truncate" title={ m.ID }>{ m.ID }</span>
				if m.Whitelisted {
					@components.StatusBadge(components.StatusBadgeProps{
						Variant: components.StatusInfo,
						Class:   "text-[10px] px-1.5 py-0",
					}) {
						Whitelisted
					}
				} else {
					@components.StatusBadge(components.StatusBadgeProps{
						Variant: components.StatusNeutral,
						Class:   "text-[10px] px-1.5 py-0",
					}) {
						Catalog
					}
				}
			</div>
			if m.Name != "" && m.Name != m.ID {
				<p class="text-[11px] font-mono text-muted-foreground truncate" title={ m.Name }>{ m.Name }</p>
			}
		</div>
		<div class="pt-2 border-t border-border flex items-center justify-between">
			if m.Whitelisted {
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantSecondary,
						Size:    button.SizeSm,
						Class:   "text-[11px] gap-1.5 cursor-pointer",
						Attributes: templ.Attributes{
							"data-provider": provider,
							"data-model":    m.ID,
							"onclick":       "testModelProbe(this, this.dataset.provider, this.dataset.model)",
						},
					}) {
						@icon.RefreshCw(icon.Props{Class: "size-3 text-muted-foreground"})
						<span>Test Probe</span>
					}
					<form method="POST" action="/dashboard/models/remove" class="inline">
						<input type="hidden" name="provider" value={ provider }/>
						<input type="hidden" name="model" value={ m.ID }/>
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantGhost,
							Size:    button.SizeSm,
							Class:   "text-destructive hover:text-destructive/80 text-[11px]",
						}) {
							Remove
						}
					</form>
				</div>
			} else {
				<form method="POST" action="/dashboard/models/add" class="w-full">
					<input type="hidden" name="provider" value={ provider }/>
					<input type="hidden" name="model" value={ m.ID }/>
					@button.Button(button.Props{
						Type:      button.TypeSubmit,
						Variant:   button.VariantOutline,
						Size:      button.SizeSm,
						FullWidth: true,
						Class:     "gap-1 text-xs",
					}) {
						@icon.Plus(icon.Props{Class: "size-3.5"})
						<span>Add to Whitelist</span>
					}
				</form>
			}
		</div>
	</div>
}

templ providerDetailScripts() {
	<script>
		function testModelProbe(btn, provider, model) {
			if (!window.tui || !window.tui.toast) return;
			const origHtml = btn.innerHTML;
			btn.disabled = true;
			btn.classList.add('opacity-50', 'pointer-events-none');

			window.tui.toast.promise(
				fetch('/dashboard/models/test', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/x-www-form-urlencoded',
						'Accept': 'application/json'
					},
					body: new URLSearchParams({ provider: provider, model: model })
				}).then(async (res) => {
					const data = await res.json().catch(() => ({}));
					if (!res.ok || !data.ok) {
						throw new Error(data.error || `Probe returned HTTP ${res.status}`);
					}
					return data;
				}).finally(() => {
					btn.disabled = false;
					btn.classList.remove('opacity-50', 'pointer-events-none');
					btn.innerHTML = origHtml;
				}),
				{
					loading: `Probing model '${model}'...`,
					success: (data) => data.message || `Model '${model}' probe succeeded!`,
					error: (err) => err.message || `Model '${model}' probe failed`
				}
			);
		}

		// Device code polling vanilla runner
		(function() {
			const banner = document.getElementById('device-auth-banner');
			if (!banner) return;

			const deviceCode = banner.getAttribute('data-device-code');
			const deviceID = banner.getAttribute('data-device-id');
			const provider = banner.getAttribute('data-provider');
			const account = banner.getAttribute('data-account') || '';
			const statusEl = document.getElementById('device-auth-status');
			const restartBtn = document.getElementById('device-auth-restart');

			let polling = true;

			function poll() {
				if (!polling) return;
				fetch(`/dashboard/providers/${encodeURIComponent(provider)}/oauth/device/poll`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: `device_code=${encodeURIComponent(deviceCode)}&device_id=${encodeURIComponent(deviceID)}&account=${encodeURIComponent(account)}`
				})
				.then(r => r.json())
				.then(d => {
					if (d.status === 'success') {
						polling = false;
						const accName = d.account || 'default';
						window.location.href = `/dashboard/providers/${encodeURIComponent(provider)}?flash=` + encodeURIComponent(`Successfully connected account '${accName}'!`);
					} else if (d.status === 'error') {
						polling = false;
						if (statusEl) statusEl.textContent = 'Error: ' + d.message;
						if (restartBtn) restartBtn.classList.remove('hidden');
					}
				})
				.catch(err => {
					console.error('Polling error:', err);
				});
			}

			poll();
			const interval = setInterval(function() {
				if (polling) {
					poll();
				} else {
					clearInterval(interval);
				}
			}, 5000);
		})();
	</script>
}
