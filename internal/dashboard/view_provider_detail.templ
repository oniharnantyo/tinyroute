package dashboard

import (
	"fmt"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/breadcrumb"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/inputgroup"
)

type CatalogModelItem struct {
	ID          string
	Name        string
	Whitelisted bool
}

type ProviderDetailPageData struct {
	Name              string
	DisplayName       string
	Logo              string
	Dialect           string
	BaseURL           string
	APIKey            string
	Configured        bool
	OAuthCapable      bool
	HealthStatus      string // "healthy", "cooldown"
	Status            string // "connected", "cooldown", "awaiting_credentials", "not_connected"
	Connections       []MaskedConnectionItem
	Models            []CatalogModelItem
	WhitelistedModels []CatalogModelItem
	AvailableModels   []CatalogModelItem
	DeviceCode        string
	UserCode          string
	VerificationURI   string
	DeviceID          string
}

templ ProviderDetailPage(data ProviderDetailPageData) {
	<div class="space-y-6">
		<!-- Header Breadcrumb & Actions -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-4">
			<div class="space-y-2">
				@breadcrumb.Breadcrumb() {
					@breadcrumb.List() {
						@breadcrumb.Item() {
							@breadcrumb.Link(breadcrumb.LinkProps{Href: "/dashboard/providers"}) {
								Providers
							}
						}
						@breadcrumb.Separator()
						@breadcrumb.Item() {
							@breadcrumb.Page() {
								if data.DisplayName != "" {
									{ data.DisplayName }
								} else {
									{ data.Name }
								}
							}
						}
					}
				}
				<div class="flex items-center space-x-3">
					@providerLogo(data.Name, data.Logo)
					<h2 class="text-xl font-bold tracking-tight text-foreground">
						if data.DisplayName != "" {
							{ data.DisplayName }
						} else {
							{ data.Name }
						}
					</h2>
				</div>
			</div>
		</div>

		<!-- DEVICE CODE POLLING MODAL BANNER -->
		if data.DeviceCode != "" {
			<div
				id="device-auth-banner"
				data-device-code={ data.DeviceCode }
				data-device-id={ data.DeviceID }
				data-provider={ data.Name }
				class="bg-card border border-primary/40 rounded-xl p-6 shadow-xl space-y-4"
			>
				<div class="flex items-center justify-between border-b border-border pb-3">
					<h3 class="font-bold text-sm text-foreground uppercase tracking-wider flex items-center gap-2">
						@icon.Key(icon.Props{Class: "size-4 text-primary"})
						Device Authorization Required
					</h3>
					<span id="device-auth-status" class="text-xs text-primary font-mono">polling...</span>
				</div>
				<div class="space-y-3 text-xs">
					<p class="text-muted-foreground">Open the verification URL below and enter your user code to authorize:</p>
					<div class="p-3.5 bg-muted/50 border border-border rounded-lg space-y-2 font-mono">
						<div class="flex items-center justify-between">
							<span class="text-muted-foreground">User Code:</span>
							<span class="font-bold text-primary text-sm">{ data.UserCode }</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-muted-foreground">Verification URL:</span>
							<a href={ templ.SafeURL(data.VerificationURI) } target="_blank" class="text-primary hover:underline truncate max-w-xs">{ data.VerificationURI }</a>
						</div>
					</div>
					<div class="flex items-center gap-3 pt-2">
						@button.Button(button.Props{
							Href:   data.VerificationURI,
							Target: "_blank",
							Class:  "gap-1.5 shadow-sm",
						}) {
							<span>Open Authorization Page</span>
							@icon.ExternalLink(icon.Props{Class: "size-3.5"})
						}
						<a
							id="device-auth-restart"
							href={ templ.SafeURL(fmt.Sprintf("/dashboard/providers/%s/oauth/start", data.Name)) }
							class="hidden inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-md text-xs font-medium bg-amber-600 hover:bg-amber-500 text-white shadow-sm transition-colors"
						>
							@icon.RefreshCw(icon.Props{Class: "size-3.5"})
							<span>Restart Authorization</span>
						</a>
					</div>
				</div>
			</div>
		}

		<!-- CONNECTIONS SECTION -->
		@card.Card() {
			@card.Header(card.HeaderProps{Class: "border-b border-border pb-3 flex flex-row items-center justify-between space-y-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm font-semibold uppercase tracking-wider flex items-center gap-2 text-foreground"}) {
					@icon.Lock(icon.Props{Class: "size-4 text-primary"})
					Connections & Credentials
				}
				<span class="text-xs text-muted-foreground font-mono">{ fmt.Sprintf("%d active connections", len(data.Connections)) }</span>
			}
			@card.Content(card.ContentProps{Class: "p-6 space-y-4"}) {
				if len(data.Connections) > 0 {
					<div class="space-y-2">
						for _, conn := range data.Connections {
							<div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 bg-muted/40 border border-border rounded-lg text-xs font-mono gap-2">
								<div class="space-y-0.5">
									<span class="font-bold text-foreground">{ conn.Account }</span>
									<div class="text-muted-foreground text-[11px]">Token Digest: { conn.RefreshToken }</div>
								</div>
								<div class="flex items-center gap-3">
									<span class="text-muted-foreground text-[11px]">Expires: { conn.ExpiresAt }</span>
									<form method="POST" action="/dashboard/providers/credential/delete" onsubmit="return confirm('Are you sure you want to remove this OAuth connection?');">
										<input type="hidden" name="name" value={ data.Name }/>
										<input type="hidden" name="account" value={ conn.Account }/>
										<input type="hidden" name="type" value="oauth"/>
										<button type="submit" class="p-1.5 text-muted-foreground hover:text-destructive transition-colors cursor-pointer" title="Remove OAuth Connection">
											@icon.Trash(icon.Props{Class: "size-3.5"})
										</button>
									</form>
								</div>
							</div>
						}
					</div>
				} else {
					<p class="text-xs text-muted-foreground italic">No OAuth or stored credential records. You can save a static API Key below.</p>
				}

				if data.APIKey != "" {
					<div class="p-3.5 bg-muted/40 border border-border rounded-lg text-xs font-mono flex items-center justify-between">
						<div class="space-y-0.5">
							<span class="text-foreground font-medium">Static API Key</span>
							<div class="text-emerald-400 text-[11px]">Configured</div>
						</div>
						<form method="POST" action="/dashboard/providers/credential/delete" onsubmit="return confirm('Are you sure you want to remove the API key?');">
							<input type="hidden" name="name" value={ data.Name }/>
							<input type="hidden" name="type" value="api_key"/>
							@button.Button(button.Props{
								Type:    button.TypeSubmit,
								Variant: button.VariantDestructive,
								Size:    button.SizeSm,
								Class:   "gap-1.5",
							}) {
								@icon.Trash(icon.Props{Class: "size-3.5"})
								<span>Remove API Key</span>
							}
						</form>
					</div>
				}

				if data.OAuthCapable {
					<div class="pt-3 border-t border-border flex items-center justify-between">
						<div class="space-y-0.5">
							<span class="text-xs font-medium text-foreground">OAuth Connection</span>
							<p class="text-[11px] text-muted-foreground">Authenticate with { data.DisplayName } using OAuth in browser</p>
						</div>
						@button.Button(button.Props{
							Href:  fmt.Sprintf("/dashboard/providers/%s/oauth/start", data.Name),
							Class: "gap-2 shadow-sm",
						}) {
							@icon.Key(icon.Props{Class: "size-4"})
							<span>Connect with OAuth</span>
						}
					</div>
				}

				if !data.OAuthCapable {
					<form method="POST" action="/dashboard/providers/credential" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-3 border-t border-border">
						<input type="hidden" name="name" value={ data.Name }/>
						<input type="password" name="api_key" placeholder="Paste API Key / Secret Token (starts with sk-...)" class="flex-1 px-3.5 py-2 bg-transparent border border-input rounded-md text-xs text-foreground placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none font-mono"/>
						@button.Button(button.Props{
							Type:  button.TypeSubmit,
							Class: "shrink-0",
						}) {
							Save API Key Secret
						}
					</form>
				}
			}
		}

		<!-- MODELS SECTION -->
		@card.Card() {
			@card.Header(card.HeaderProps{Class: "border-b border-border pb-3 flex flex-row items-center justify-between space-y-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm font-semibold uppercase tracking-wider flex items-center gap-2 text-foreground"}) {
					@icon.Cpu(icon.Props{Class: "size-4 text-primary"})
					Models ({ fmt.Sprintf("%d", len(data.Models)) })
				}
			}

			@card.Content(card.ContentProps{Class: "p-6 space-y-6"}) {
				if len(data.Models) == 0 {
					<p class="text-xs text-muted-foreground italic">No catalog models found. Enter a custom model name below to whitelist it.</p>
				} else {
					<div class="space-y-6">
						<div class="flex items-center">
							<div class="w-full sm:w-72">
								@inputgroup.InputGroup() {
									@inputgroup.Addon() {
										@icon.Search()
									}
									@inputgroup.Input(inputgroup.InputProps{
										Type:        "search",
										Placeholder: "Filter models...",
										Attributes:  templ.Attributes{"data-filter-input": "models"},
									})
								}
							</div>
						</div>

						if len(data.WhitelistedModels) > 0 {
							<div class="space-y-3">
								<div class="flex items-center gap-2">
									<span class="size-2 rounded-full bg-primary"></span>
									<h4 class="text-xs font-semibold text-foreground uppercase tracking-wider">Whitelisted ({ fmt.Sprintf("%d", len(data.WhitelistedModels)) })</h4>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
									for _, m := range data.WhitelistedModels {
										@modelCard(data.Name, m)
									}
								</div>
							</div>
						}

						if len(data.AvailableModels) > 0 {
							<div class="space-y-3">
								<div class="flex items-center gap-2">
									<span class="size-2 rounded-full bg-muted-foreground"></span>
									<h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Available in Catalog ({ fmt.Sprintf("%d", len(data.AvailableModels)) })</h4>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
									for _, m := range data.AvailableModels {
										@modelCard(data.Name, m)
									}
								</div>
							</div>
						}
					</div>
				}

				<!-- Custom Model Input Escape Hatch -->
				<form method="POST" action="/dashboard/models/add" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-4 border-t border-border">
					<input type="hidden" name="provider" value={ data.Name }/>
					<input type="text" id="custom_model_input" name="model" placeholder="Custom model name (e.g. gpt-4o)" required class="flex-1 px-3.5 py-2 bg-transparent border border-input rounded-md text-xs text-foreground placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none font-mono"/>
					@button.Button(button.Props{
						Type:  button.TypeSubmit,
						Class: "shrink-0 gap-1.5",
					}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						<span>Add Model</span>
					}
				</form>
			}
		}

		@providerDetailScripts()
	</div>
}

templ modelCard(provider string, m CatalogModelItem) {
	<div
		data-filter-item="models"
		data-filter-text={ fmt.Sprintf("%s %s", m.ID, m.Name) }
		class="p-3.5 bg-card border border-border rounded-lg space-y-2.5 flex flex-col justify-between"
	>
		<div>
			<div class="flex items-center justify-between gap-2">
				<span class="font-bold text-xs text-foreground font-mono tracking-tight truncate" title={ m.ID }>{ m.ID }</span>
				if m.Whitelisted {
					@components.StatusBadge(components.StatusBadgeProps{
						Variant: components.StatusInfo,
						Class:   "text-[10px] px-1.5 py-0",
					}) {
						Whitelisted
					}
				} else {
					@components.StatusBadge(components.StatusBadgeProps{
						Variant: components.StatusNeutral,
						Class:   "text-[10px] px-1.5 py-0",
					}) {
						Catalog
					}
				}
			</div>
			if m.Name != "" && m.Name != m.ID {
				<p class="text-[11px] font-mono text-muted-foreground truncate" title={ m.Name }>{ m.Name }</p>
			}
		</div>
		<div class="pt-2 border-t border-border flex items-center justify-between">
			if m.Whitelisted {
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantSecondary,
						Size:    button.SizeSm,
						Class:   "text-[11px] gap-1.5 cursor-pointer",
						Attributes: templ.Attributes{
							"data-provider": provider,
							"data-model":    m.ID,
							"onclick":       "testModelProbe(this, this.dataset.provider, this.dataset.model)",
						},
					}) {
						@icon.RefreshCw(icon.Props{Class: "size-3 text-muted-foreground"})
						<span>Test Probe</span>
					}
					<form method="POST" action="/dashboard/models/remove" class="inline">
						<input type="hidden" name="provider" value={ provider }/>
						<input type="hidden" name="model" value={ m.ID }/>
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantGhost,
							Size:    button.SizeSm,
							Class:   "text-destructive hover:text-destructive/80 text-[11px]",
						}) {
							Remove
						}
					</form>
				</div>
			} else {
				<form method="POST" action="/dashboard/models/add" class="w-full">
					<input type="hidden" name="provider" value={ provider }/>
					<input type="hidden" name="model" value={ m.ID }/>
					@button.Button(button.Props{
						Type:      button.TypeSubmit,
						Variant:   button.VariantOutline,
						Size:      button.SizeSm,
						FullWidth: true,
						Class:     "gap-1 text-xs",
					}) {
						@icon.Plus(icon.Props{Class: "size-3.5"})
						<span>Add to Whitelist</span>
					}
				</form>
			}
		</div>
	</div>
}

templ providerDetailScripts() {
	<script>
		function testModelProbe(btn, provider, model) {
			if (!window.tui || !window.tui.toast) return;
			const origHtml = btn.innerHTML;
			btn.disabled = true;
			btn.classList.add('opacity-50', 'pointer-events-none');

			window.tui.toast.promise(
				fetch('/dashboard/models/test', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/x-www-form-urlencoded',
						'Accept': 'application/json'
					},
					body: new URLSearchParams({ provider: provider, model: model })
				}).then(async (res) => {
					const data = await res.json().catch(() => ({}));
					if (!res.ok || !data.ok) {
						throw new Error(data.error || `Probe returned HTTP ${res.status}`);
					}
					return data;
				}).finally(() => {
					btn.disabled = false;
					btn.classList.remove('opacity-50', 'pointer-events-none');
					btn.innerHTML = origHtml;
				}),
				{
					loading: `Probing model '${model}'...`,
					success: (data) => data.message || `Model '${model}' probe succeeded!`,
					error: (err) => err.message || `Model '${model}' probe failed`
				}
			);
		}

		// Device code polling vanilla runner
		(function() {
			const banner = document.getElementById('device-auth-banner');
			if (!banner) return;

			const deviceCode = banner.getAttribute('data-device-code');
			const deviceID = banner.getAttribute('data-device-id');
			const provider = banner.getAttribute('data-provider');
			const statusEl = document.getElementById('device-auth-status');
			const restartBtn = document.getElementById('device-auth-restart');

			let polling = true;

			function poll() {
				if (!polling) return;
				fetch(`/dashboard/providers/${encodeURIComponent(provider)}/oauth/device/poll`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: `device_code=${encodeURIComponent(deviceCode)}&device_id=${encodeURIComponent(deviceID)}`
				})
				.then(r => r.json())
				.then(d => {
					if (d.status === 'success') {
						polling = false;
						window.location.href = `/dashboard/providers/${encodeURIComponent(provider)}?flash=` + encodeURIComponent('Successfully connected OAuth!');
					} else if (d.status === 'error') {
						polling = false;
						if (statusEl) statusEl.textContent = 'Error: ' + d.message;
						if (restartBtn) restartBtn.classList.remove('hidden');
					}
				})
				.catch(err => {
					console.error('Polling error:', err);
				});
			}

			poll();
			const interval = setInterval(function() {
				if (polling) {
					poll();
				} else {
					clearInterval(interval);
				}
			}, 5000);
		})();
	</script>
}
