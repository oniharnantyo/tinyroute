package dashboard

import (
	"fmt"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/empty"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/table"
)

type ProviderHealthItem struct {
	Name          string
	Dialect       string
	Status        string // "healthy", "cooldown"
	CooldownUntil string
}

type RecentFailureItem struct {
	ID         string
	Time       string
	Provider   string
	Model      string
	StatusCode int
	ErrorMsg   string
}

type OverviewData struct {
	TotalRequests         int64
	SuccessRate           float64
	TotalPromptTokens     int64
	TotalCompletionTokens int64
	ProviderHealthList    []ProviderHealthItem
	RecentFailures        []RecentFailureItem
}

templ OverviewPage(data OverviewData) {
	<div class="space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold tracking-tight text-foreground">System Overview</h2>
				<p class="text-xs text-muted-foreground">Live traffic statistics and provider health status</p>
			</div>
			<div class="flex items-center gap-2">
				@components.StatusBadge(components.StatusBadgeProps{Variant: components.StatusSuccess, Class: "px-2.5 py-1 gap-1.5"}) {
					<span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
					Gateway Active
				}
			</div>
		</div>

		<!-- KPI Cards -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			@components.KPICard(components.KPICardProps{
				Title:       "Total Requests",
				Value:       fmt.Sprintf("%d", data.TotalRequests),
				Description: "Processed through gateway",
				Icon:        icon.Activity,
			})

			@components.KPICard(components.KPICardProps{
				Title:       "Success Rate",
				Value:       fmt.Sprintf("%.1f%%", data.SuccessRate),
				Description: "Successful completions",
				Icon:        icon.Check,
			})

			@components.KPICard(components.KPICardProps{
				Title:       "Prompt Tokens",
				Value:       fmt.Sprintf("%d", data.TotalPromptTokens),
				Description: "Inbound prompt usage",
				Icon:        icon.Server,
			})

			@components.KPICard(components.KPICardProps{
				Title:       "Completion Tokens",
				Value:       fmt.Sprintf("%d", data.TotalCompletionTokens),
				Description: "Outbound completion usage",
				Icon:        icon.Cpu,
			})
		</div>

		<!-- Provider Health & Recent Failures Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Provider Health List -->
			<div class="lg:col-span-1">
				@card.Card() {
					@card.Header(card.HeaderProps{Class: "flex flex-row items-center justify-between space-y-0 border-b border-border pb-3"}) {
						@card.Title(card.TitleProps{Class: "text-sm font-semibold flex items-center gap-2 text-foreground"}) {
							@icon.Cpu(icon.Props{Class: "size-4 text-primary"})
							Provider Health
						}
						<span class="text-xs font-mono text-muted-foreground">{ fmt.Sprintf("%d total", len(data.ProviderHealthList)) }</span>
					}

					@card.Content(card.ContentProps{Class: "p-4"}) {
						if len(data.ProviderHealthList) == 0 {
							<p class="text-xs text-muted-foreground text-center py-6">No providers configured</p>
						} else {
							<div class="space-y-2.5">
								for _, p := range data.ProviderHealthList {
									<div class="flex items-center justify-between p-3 bg-muted/40 border border-border rounded-lg text-xs">
										<div class="space-y-0.5">
											<div class="font-medium text-foreground">{ p.Name }</div>
											<div class="text-[11px] font-mono text-muted-foreground">{ p.Dialect }</div>
										</div>
										<div>
											if p.Status == "healthy" {
												@components.StatusBadge(components.StatusBadgeProps{Variant: components.StatusSuccess}) {
													Healthy
												}
											} else {
												@components.StatusBadge(components.StatusBadgeProps{
													Variant:    components.StatusError,
													Attributes: templ.Attributes{"title": "Cooldown until " + p.CooldownUntil},
												}) {
													Cooldown
												}
											}
										</div>
									</div>
								}
							</div>
						}
					}
				}
			</div>

			<!-- Recent Failures Table -->
			<div class="lg:col-span-2">
				@card.Card() {
					@card.Header(card.HeaderProps{Class: "flex flex-row items-center justify-between space-y-0 border-b border-border pb-3"}) {
						@card.Title(card.TitleProps{Class: "text-sm font-semibold flex items-center gap-2 text-foreground"}) {
							@icon.TriangleAlert(icon.Props{Class: "size-4 text-amber-400"})
							Recent Failures
						}
						<span class="text-xs font-mono text-muted-foreground">Last 10 failures</span>
					}

					@card.Content(card.ContentProps{Class: "p-0"}) {
						if len(data.RecentFailures) == 0 {
							<div class="p-8">
								@empty.Empty() {
									@empty.Header() {
										@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
											@icon.Check()
										}
										@empty.Title() { No recent failures }
										@empty.Description() { All gateway requests succeeded smoothly. }
									}
								}
							</div>
						} else {
							<div class="overflow-x-auto">
								@table.Table() {
									@table.Header() {
										@table.Row() {
											@table.Head(table.HeadProps{Class: "py-2.5 px-3 font-semibold text-xs"}) {
												Time
											}
											@table.Head(table.HeadProps{Class: "py-2.5 px-3 font-semibold text-xs"}) {
												Provider
											}
											@table.Head(table.HeadProps{Class: "py-2.5 px-3 font-semibold text-xs"}) {
												Model
											}
											@table.Head(table.HeadProps{Class: "py-2.5 px-3 font-semibold text-xs"}) {
												Status
											}
											@table.Head(table.HeadProps{Class: "py-2.5 px-3 font-semibold text-xs"}) {
												Error
											}
										}
									}
									@table.Body(table.BodyProps{Class: "font-mono text-xs"}) {
										for _, f := range data.RecentFailures {
											@table.Row() {
												@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-muted-foreground"}) {
													{ f.Time }
												}
												@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-foreground font-sans font-medium"}) {
													{ f.Provider }
												}
												@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-foreground/80"}) {
													{ f.Model }
												}
												@table.Cell(table.CellProps{Class: "py-2.5 px-3"}) {
													@components.StatusBadge(components.StatusBadgeProps{Variant: components.StatusError}) {
														{ fmt.Sprintf("%d", f.StatusCode) }
													}
												}
												@table.Cell(table.CellProps{
													Class:      "py-2.5 px-3 text-muted-foreground truncate max-w-xs font-sans",
													Attributes: templ.Attributes{"title": f.ErrorMsg},
												}) {
													{ f.ErrorMsg }
												}
											}
										}
									}
								}
							</div>
						}
					}
				}
			</div>
		</div>
	</div>
}
