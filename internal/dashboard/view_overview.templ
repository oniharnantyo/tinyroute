package dashboard

import (
	"fmt"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
)

type ProviderHealthItem struct {
	Name          string
	Dialect       string
	Status        string // "healthy", "cooldown"
	CooldownUntil string
}

type RecentFailureItem struct {
	ID         string
	Time       string
	Provider   string
	Model      string
	StatusCode int
	ErrorMsg   string
}

type OverviewData struct {
	TotalRequests         int64
	SuccessRate           float64
	TotalPromptTokens     int64
	TotalCompletionTokens int64
	ProviderHealthList    []ProviderHealthItem
	RecentFailures        []RecentFailureItem
}

templ OverviewPage(data OverviewData) {
	<div class="space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold tracking-tight text-white">System Overview</h2>
				<p class="text-xs text-slate-400">Live traffic statistics and provider health status</p>
			</div>
			<div class="flex items-center gap-2">
				<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
					Gateway Active
				</span>
			</div>
		</div>

		<!-- KPI Cards -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
				<div class="flex items-center justify-between text-slate-400">
					<span class="text-xs font-medium uppercase tracking-wider">Total Requests</span>
					@components.Icon("activity", "w-4 h-4 text-indigo-400")
				</div>
				<div class="text-2xl font-bold tracking-tight text-white">{ fmt.Sprintf("%d", data.TotalRequests) }</div>
				<p class="text-[11px] text-slate-500">Processed through gateway</p>
			</div>

			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
				<div class="flex items-center justify-between text-slate-400">
					<span class="text-xs font-medium uppercase tracking-wider">Success Rate</span>
					@components.Icon("check", "w-4 h-4 text-emerald-400")
				</div>
				<div class="text-2xl font-bold tracking-tight text-white">{ fmt.Sprintf("%.1f%%", data.SuccessRate) }</div>
				<p class="text-[11px] text-slate-500">Successful completions</p>
			</div>

			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
				<div class="flex items-center justify-between text-slate-400">
					<span class="text-xs font-medium uppercase tracking-wider">Prompt Tokens</span>
					@components.Icon("server", "w-4 h-4 text-indigo-400")
				</div>
				<div class="text-2xl font-bold tracking-tight text-white">{ fmt.Sprintf("%d", data.TotalPromptTokens) }</div>
				<p class="text-[11px] text-slate-500">Inbound prompt usage</p>
			</div>

			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
				<div class="flex items-center justify-between text-slate-400">
					<span class="text-xs font-medium uppercase tracking-wider">Completion Tokens</span>
					@components.Icon("cpu", "w-4 h-4 text-indigo-400")
				</div>
				<div class="text-2xl font-bold tracking-tight text-white">{ fmt.Sprintf("%d", data.TotalCompletionTokens) }</div>
				<p class="text-[11px] text-slate-500">Outbound completion usage</p>
			</div>
		</div>

		<!-- Provider Health & Recent Failures Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Provider Health List -->
			<div class="lg:col-span-1 bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
				<div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
					<h3 class="font-semibold text-sm text-white flex items-center gap-2">
						@components.Icon("cpu", "w-4 h-4 text-indigo-400")
						Provider Health
					</h3>
					<span class="text-xs font-mono text-slate-500">{ fmt.Sprintf("%d total", len(data.ProviderHealthList)) }</span>
				</div>

				if len(data.ProviderHealthList) == 0 {
					<p class="text-xs text-slate-500 text-center py-6">No providers configured</p>
				} else {
					<div class="space-y-2.5">
						for _, p := range data.ProviderHealthList {
							<div class="flex items-center justify-between p-3 bg-slate-950/60 border border-slate-800/60 rounded-xl text-xs">
								<div class="space-y-0.5">
									<div class="font-medium text-white">{ p.Name }</div>
									<div class="text-[11px] font-mono text-slate-500">{ p.Dialect }</div>
								</div>
								<div>
									if p.Status == "healthy" {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
											Healthy
										</span>
									} else {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20" title={ "Cooldown until " + p.CooldownUntil }>
											Cooldown
										</span>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Recent Failures Table -->
			<div class="lg:col-span-2 bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
				<div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
					<h3 class="font-semibold text-sm text-white flex items-center gap-2">
						@components.Icon("alert-triangle", "w-4 h-4 text-amber-400")
						Recent Failures
					</h3>
					<span class="text-xs font-mono text-slate-500">Last 10 failures</span>
				</div>

				if len(data.RecentFailures) == 0 {
					<div class="text-center py-10 space-y-1">
						@components.Icon("check", "w-8 h-8 text-emerald-400/60 mx-auto")
						<p class="text-xs text-slate-400 font-medium">No recent failures</p>
						<p class="text-[11px] text-slate-500">All gateway requests succeeded smoothly</p>
					</div>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-xs">
							<thead>
								<tr class="border-b border-slate-800 text-slate-400 font-medium">
									<th class="py-2.5 px-3">Time</th>
									<th class="py-2.5 px-3">Provider</th>
									<th class="py-2.5 px-3">Model</th>
									<th class="py-2.5 px-3">Status</th>
									<th class="py-2.5 px-3">Error</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60 font-mono text-[11px]">
								for _, f := range data.RecentFailures {
									<tr class="hover:bg-slate-800/30 transition-colors">
										<td class="py-2.5 px-3 text-slate-400">{ f.Time }</td>
										<td class="py-2.5 px-3 text-slate-200">{ f.Provider }</td>
										<td class="py-2.5 px-3 text-slate-300">{ f.Model }</td>
										<td class="py-2.5 px-3">
											<span class="px-2 py-0.5 rounded text-rose-400 bg-rose-500/10 border border-rose-500/20">{ fmt.Sprintf("%d", f.StatusCode) }</span>
										</td>
										<td class="py-2.5 px-3 text-slate-400 truncate max-w-xs" title={ f.ErrorMsg }>{ f.ErrorMsg }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	</div>
}
