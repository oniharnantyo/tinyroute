package dashboard

import (

	"fmt"
	"github.com/oniharnantyo/tinyroute/internal/core"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/button"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/calendar"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/empty"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/label"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/popover"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/table"
	"github.com/oniharnantyo/tinyroute/internal/history"
	"net/url"
	"strconv"
	"time"
	selectcomp "github.com/oniharnantyo/tinyroute/internal/dashboard/components/select"
)

func parseDateSafe(s string) time.Time {
	if s == "" {
		return time.Time{}
	}
	t, _ := time.ParseInLocation("2006-01-02", s, time.Local)
	return t
}

func formatRangeLabel(from, to string) string {
	if from != "" && to != "" {
		if from == to {
			return from
		}
		return from + " → " + to
	}
	if from != "" {
		return "From " + from
	}
	if to != "" {
		return "Until " + to
	}
	return "Pick date range"
}

type HistoryRowItem struct {
	ID               string
	Timestamp        string
	Dialect          string
	Model            string
	KeyID            string
	Outcome          string
	StatusCode       int
	StatusVariant    components.StatusBadgeVariant
	PromptTokens     int64
	CompletionTokens int64
	LatencyMs        int64
	Attempts         []core.Attempt
}

type HistoryPageData struct {
	Rows               []HistoryRowItem
	FilterProvider     string
	FilterFrom         string
	FilterTo           string
	Limit              int
	HasMore            bool
	AvailableProviders []string
}

func (data HistoryPageData) LoadMoreURL() string {
	q := url.Values{}
	if data.FilterProvider != "" {
		q.Set("provider", data.FilterProvider)
	}
	if data.FilterFrom != "" {
		q.Set("from", data.FilterFrom)
	}
	if data.FilterTo != "" {
		q.Set("to", data.FilterTo)
	}
	nextLimit := data.Limit + 50
	if nextLimit > history.MaxListLimit {
		nextLimit = history.MaxListLimit
	}
	q.Set("limit", strconv.Itoa(nextLimit))
	return "/dashboard/history?" + q.Encode() + "#history-table"
}

templ HistoryPage(data HistoryPageData) {
	<div class="space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			@card.Header(card.HeaderProps{Class: "p-0 pb-0 space-y-1"}) {
				@card.Title(card.TitleProps{Class: "text-xl font-bold tracking-tight text-foreground font-sans"}) {
					Request History
				}
				@card.Description(card.DescriptionProps{Class: "text-xs text-muted-foreground"}) {
					Audit request logs, token spend, attempt chains, and status codes
				}
			}
		</div>

		<!-- History Filters -->
		@historyFilters(data)

		<!-- History Table -->
		if len(data.Rows) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.History()
					}
					@empty.Title() { No request history found }
					@empty.Description() { No requests found matching the current filter criteria. }
				}
			}
		} else {
			@card.Card() {
				<div id="history-table" class="overflow-x-auto scroll-fade">
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Time
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Endpoint
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Model
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Key ID
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Status
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Latency
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 font-semibold text-xs"}) {
									Tokens (In/Out)
								}
								@table.Head(table.HeadProps{Class: "py-3 px-3 text-right font-semibold text-xs"}) {
									Details
								}
							}
						}
						@table.Body(table.BodyProps{Class: "font-mono text-xs"}) {
							for _, row := range data.Rows {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-muted-foreground"}) {
										{ row.Timestamp }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-foreground font-sans font-medium"}) {
										{ row.Dialect }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-foreground font-semibold"}) {
										{ row.Model }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-muted-foreground"}) {
										{ row.KeyID }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3"}) {
										@components.StatusBadge(components.StatusBadgeProps{Variant: row.StatusVariant}) {
											{ fmt.Sprintf("%d", row.StatusCode) }
										}
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-foreground/80"}) {
										{ fmt.Sprintf("%d ms", row.LatencyMs) }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-muted-foreground"}) {
										{ fmt.Sprintf("%d / %d", row.PromptTokens, row.CompletionTokens) }
									}
									@table.Cell(table.CellProps{Class: "py-2.5 px-3 text-right font-sans"}) {
										@button.Button(button.Props{
											Href:    fmt.Sprintf("/dashboard/history/%s", row.ID),
											Variant: button.VariantSecondary,
											Size:    button.SizeSm,
											Class:   "text-[11px] h-7 px-2.5",
										}) {
											Inspect
										}
									}
								}
							}
						}
					}
				</div>

				@card.Footer(card.FooterProps{
					Class: "flex flex-col sm:flex-row items-center justify-between gap-3 p-4 border-t border-border text-xs text-muted-foreground font-sans",
				}) {
					<div>
						if len(data.Rows) == 1 {
							<span>Showing 1 request</span>
						} else {
							<span>Showing { fmt.Sprintf("%d", len(data.Rows)) } requests</span>
						}
					</div>
					if data.HasMore {
						@button.Button(button.Props{
							Href:    data.LoadMoreURL(),
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "gap-1.5",
						}) {
							@icon.RefreshCw(icon.Props{Class: "size-3.5"})
							<span>Load More</span>
						}
					}
				}
			}
		}
	</div>
}

// historyFilters renders the provider/date-range filter card above the history
// table. The form submits GET params (provider, from, to) back to the history
// view, so each control contributes a named field.
templ historyFilters(data HistoryPageData) {
	{{ hasActiveFilters := data.FilterProvider != "" || data.FilterFrom != "" || data.FilterTo != "" }}
	@card.Card(card.Props{Class: "p-4"}) {
		<form method="GET" action="/dashboard/history" class="flex flex-col gap-3 sm:flex-row sm:items-end">
			<div class="space-y-2 sm:flex-1">
				@label.Label(label.Props{For: "history-provider", Class: "text-xs font-medium text-foreground"}) {
					Provider
				}
				@selectcomp.Select(selectcomp.Props{
					Name:         "provider",
					DefaultValue: data.FilterProvider,
				}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{
						ID:    "history-provider",
						Class: "w-full h-9 data-[size=default]:h-9 rounded-md text-xs font-mono",
					}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "All providers"})
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
								All providers
							}
							for _, p := range data.AvailableProviders {
								@selectcomp.Item(selectcomp.ItemProps{Value: p, Class: "font-mono"}) {
									{ p }
								}
							}
						}
					}
				}
			</div>
			<div class="space-y-2 sm:flex-1">
				@label.Label(label.Props{For: "history-date-range", Class: "text-xs font-medium text-foreground"}) {
					Date Range
				}
				@popover.Root(popover.Props{Class: "w-full"}) {
					@popover.Trigger(popover.TriggerProps{Class: "w-full"}) {
						@button.Button(button.Props{
							ID:      "history-date-range",
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
							Class:   "w-full justify-start text-xs font-mono font-normal h-9 gap-2",
						}) {
							@icon.Calendar(icon.Props{Class: "size-3.5 text-muted-foreground"})
							<span id="date-range-label" class="truncate">{ formatRangeLabel(data.FilterFrom, data.FilterTo) }</span>
						}
					}
					@popover.Content(popover.ContentProps{
						Placement: popover.PlacementBottomStart,
						Class:     "p-0 w-auto bg-popover border border-border shadow-md rounded-lg overflow-hidden",
					}) {
						@calendar.Calendar(calendar.Props{
							Mode:           calendar.ModeRange,
							Selected:       parseDateSafe(data.FilterFrom),
							EndValue:       parseDateSafe(data.FilterTo),
							Name:           "from",
							EndName:        "to",
							NumberOfMonths: 2,
						})
					}
				}
			</div>
			<div class="flex items-center gap-2">
				@button.Button(button.Props{
					Type:  button.TypeSubmit,
					Size:  button.SizeSm,
					Class: "gap-1.5",
				}) {
					@icon.Funnel(icon.Props{Class: "size-3.5"})
					<span>Filter</span>
				}
				if hasActiveFilters {
					@button.Button(button.Props{
						Href:    "/dashboard/history",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "text-xs text-muted-foreground hover:text-foreground",
					}) {
						Reset
					}
				}
			</div>
		</form>
		<script>
			document.addEventListener('calendar-change', function(e) {
				var label = document.getElementById('date-range-label');
				if (!label) return;
				var from = e.detail && e.detail.valueISO;
				var to = e.detail && e.detail.endValueISO;
				if (from && to) {
					label.textContent = from === to ? from : from + ' → ' + to;
				} else if (from) {
					label.textContent = from;
				} else {
					label.textContent = 'Pick date range';
				}
			});
		</script>
	}
}

