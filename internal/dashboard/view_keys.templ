package dashboard

type KeyItem struct {
	ID        string
	Masked    string
	Scopes    []string
	RateSpec  string
	LastUsed  string
}

type KeysPageData struct {
	Keys []KeyItem
}

templ KeysPage(data KeysPageData) {
	<div class="space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold tracking-tight text-white">API Keys Management</h2>
				<p class="text-xs text-slate-400">View configured client authorization keys and rate limit profiles</p>
			</div>
		</div>

		if len(data.Keys) == 0 {
			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-12 text-center space-y-2">
				<p class="text-xs text-slate-400">No client API keys registered in keys.json.</p>
			</div>
		} else {
			<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse text-xs">
						<thead>
							<tr class="border-b border-slate-800 text-slate-400 font-medium uppercase tracking-wider">
								<th class="py-3 px-4">Key ID</th>
								<th class="py-3 px-4">Masked Secret</th>
								<th class="py-3 px-4">Scopes</th>
								<th class="py-3 px-4">Rate Spec</th>
								<th class="py-3 px-4">Last Activity</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/60 font-mono">
							for _, k := range data.Keys {
								<tr class="hover:bg-slate-800/30 transition-colors">
									<td class="py-3.5 px-4 font-bold text-indigo-300">{ k.ID }</td>
									<td class="py-3.5 px-4 text-slate-400 font-mono">{ k.Masked }</td>
									<td class="py-3.5 px-4">
										<div class="flex items-center space-x-1 flex-wrap gap-1">
											for _, s := range k.Scopes {
												<span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[11px] font-medium">{ s }</span>
											}
										</div>
									</td>
									<td class="py-3.5 px-4 text-slate-300">{ k.RateSpec }</td>
									<td class="py-3.5 px-4 text-slate-400">{ k.LastUsed }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
}
