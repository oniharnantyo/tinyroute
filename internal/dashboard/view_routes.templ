package dashboard

import (
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/card"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/empty"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/icon"
	"github.com/oniharnantyo/tinyroute/internal/dashboard/components/table"
)

type RouteItem struct {
	From  string
	Match string
	Chain []string
}

type RoutesPageData struct {
	Routes []RouteItem
}

templ RoutesPage(data RoutesPageData) {
	<div class="space-y-6">
		<div>
			<h2 class="text-xl font-bold tracking-tight text-foreground">Routing Strategy</h2>
			<p class="text-xs text-muted-foreground">Model fallback chains and outbound provider translation mapping</p>
		</div>

		if len(data.Routes) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Route()
					}
					@empty.Title() { No custom routes defined }
					@empty.Description() { Standard wildcard matching is in effect across all connected providers. }
				}
			}
		} else {
			@card.Card() {
				<div class="overflow-x-auto">
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head(table.HeadProps{Class: "py-3 px-4 font-semibold uppercase tracking-wider text-xs"}) {
									From Dialect
								}
								@table.Head(table.HeadProps{Class: "py-3 px-4 font-semibold uppercase tracking-wider text-xs"}) {
									Match Pattern
								}
								@table.Head(table.HeadProps{Class: "py-3 px-4 font-semibold uppercase tracking-wider text-xs"}) {
									Fallback Chain Hops
								}
							}
						}
						@table.Body(table.BodyProps{Class: "font-mono text-xs"}) {
							for _, r := range data.Routes {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "py-3.5 px-4 font-bold text-foreground font-sans"}) {
										{ r.From }
									}
									@table.Cell(table.CellProps{Class: "py-3.5 px-4 text-foreground/90 font-mono"}) {
										{ r.Match }
									}
									@table.Cell(table.CellProps{Class: "py-3.5 px-4"}) {
										<div class="flex items-center space-x-2 flex-wrap gap-y-1">
											for i, hop := range r.Chain {
												@components.StatusBadge(components.StatusBadgeProps{Variant: components.StatusNeutral}) {
													{ hop }
												}
												if i < len(r.Chain)-1 {
													@icon.ArrowRight(icon.Props{Class: "size-3.5 text-muted-foreground shrink-0"})
												}
											}
										</div>
									}
								}
							}
						}
					}
				</div>
			}
		}
	</div>
}
